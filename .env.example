# Leave cloud variables unset for local SQLite mode.
# For Vercel use a Turso database with the libSQL engine (FTS5 required).
CONVEXA_DATABASE_URL=
CONVEXA_DATABASE_AUTH_TOKEN=
# Generate once; keep the same value across redeployments.
CONVEXA_SECRET_KEY=
# Recommended for a private demonstration: controls new account registration.
CONVEXA_INVITE_CODE=
# Add personal AI keys through the app Settings; no global AI key is required.
# Optional model overrides if your provider account uses another model:
# CONVEXA_GROQ_CHAT_MODEL=openai/gpt-oss-20b
# CONVEXA_GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
